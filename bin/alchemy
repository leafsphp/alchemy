#!/usr/bin/env php
<?php

if (file_exists(dirname(__DIR__, 4) . '/vendor/autoload.php')) {
    require dirname(__DIR__, 4) . '/vendor/autoload.php';
} else {
    require dirname(__DIR__) . '/vendor/autoload.php';
}

// composer.json carries no version key (packagist derives it from tags), so
// ask composer's runtime for the installed version instead
$currentVersion = \Composer\InstalledVersions::isInstalled('leafs/alchemy')
    ? \Composer\InstalledVersions::getPrettyVersion('leafs/alchemy')
    : 'dev';

$app = sprout()->createApp([
    'name' => "
    _    _      _                          
   / \  | | ___| |__   ___ _ __ ___  _  <comment>$currentVersion</comment>
  / _ \ | |/ __| '_ \ / _ \ '_ ` _ \| | | |
 / ___ \| | (__| | | |  __/ | | | | | |_| |
/_/   \_\_|\___|_| |_|\___|_| |_| |_|\__, |
                                     |___/ 
",
    'version' => '',
]);

$app->register(new Leaf\Alchemy\Commands\InitCommand);
$app->register(new Leaf\Alchemy\Commands\AllCommand);
$app->register(new Leaf\Alchemy\Commands\TestCommand);
$app->register(new Leaf\Alchemy\Commands\LintCommand);
$app->register(new Leaf\Alchemy\Commands\FmtCommand);
$app->register(new Leaf\Alchemy\Commands\RefactorCommand);
$app->register(new Leaf\Alchemy\Commands\AnalyseCommand);
$app->register(new Leaf\Alchemy\Commands\CiCommand);
$app->register(new Leaf\Alchemy\Commands\SwitchCommand);
$app->register(new Leaf\Alchemy\Commands\InstallCommand);
$app->register(new Leaf\Alchemy\Commands\SetupCommand);
$app->register(new Leaf\Alchemy\Commands\EjectCommand);

exit((int) ($app->run(false) ?? 0));

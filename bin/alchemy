#!/usr/bin/env php
<?php

if (file_exists(dirname(__DIR__, 4) . '/vendor/autoload.php')) {
    require dirname(__DIR__, 4) . '/vendor/autoload.php';
} else {
    require dirname(__DIR__) . '/vendor/autoload.php';
}

$alchemy = json_decode(file_get_contents(dirname(__DIR__) . '/composer.json'));
$currentVersion = $alchemy->version;

$app = sprout()->createApp([
    'name' => "
    _    _      _                          
   / \  | | ___| |__   ___ _ __ ___  _  <comment>$currentVersion</comment>
  / _ \ | |/ __| '_ \ / _ \ '_ ` _ \| | | |
 / ___ \| | (__| | | |  __/ | | | | | |_| |
/_/   \_\_|\___|_| |_|\___|_| |_| |_|\__, |
                                     |___/ 
",
    'version' => '',
]);

$app->register(new Leaf\Alchemy\Commands\InstallCommand);
$app->register(new Leaf\Alchemy\Commands\SetupCommand);
// $app->register(new Leaf\Alchemy\Commands\EjectCommand);
// $app->register(new Leaf\Alchemy\Commands\RunCommand);

$app->run();
